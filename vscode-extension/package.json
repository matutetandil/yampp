{
  "name": "yampp-vscode",
  "displayName": "Yam++ Task Runner",
  "description": "Language support and task runner for Yamfile",
  "version": "0.1.0",
  "publisher": "matiasdenda",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Other"],
  "keywords": ["yampp", "yamfile", "task", "runner", "build"],
  "activationEvents": [
    "onLanguage:yamfile",
    "workspaceContains:Yamfile"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [{
      "id": "yamfile",
      "aliases": ["Yamfile", "yamfile"],
      "extensions": ["Yamfile", ".yamfile"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "yamfile",
      "scopeName": "source.yamfile",
      "path": "./syntaxes/yamfile.tmLanguage.json"
    }],
    "commands": [
      {
        "command": "yampp.runTask",
        "title": "Run Task",
        "category": "Yam++"
      },
      {
        "command": "yampp.runAllTasks",
        "title": "Run All Tasks",
        "category": "Yam++"
      },
      {
        "command": "yampp.listTasks",
        "title": "List Tasks",
        "category": "Yam++"
      },
      {
        "command": "yampp.cleanCache",
        "title": "Clean Cache",
        "category": "Yam++"
      },
      {
        "command": "yampp.showGraph",
        "title": "Show Dependency Graph",
        "category": "Yam++"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == Yamfile",
          "command": "yampp.runTask",
          "group": "yampp"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == Yamfile",
          "command": "yampp.runAllTasks",
          "group": "yampp"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "yampp",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Yam++ task to execute"
          },
          "file": {
            "type": "string",
            "description": "Path to the Yamfile",
            "default": "Yamfile"
          },
          "jobs": {
            "type": "number",
            "description": "Number of parallel jobs"
          }
        }
      }
    ],
    "configuration": {
      "title": "Yam++",
      "properties": {
        "yampp.defaultJobs": {
          "type": "number",
          "default": 0,
          "description": "Default number of parallel jobs (0 = auto)"
        },
        "yampp.showTasksInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Show Yam++ tasks in the Explorer sidebar"
        },
        "yampp.autoDetectTasks": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect Yam++ tasks"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0"
  }
}