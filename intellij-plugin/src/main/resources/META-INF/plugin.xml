<idea-plugin>
    <id>com.yampp.plugin</id>
    <name>Yam++ Task Runner</name>
    <vendor email="matutetandil@gmail.com" url="https://github.com/matutetandil/yampp">Matias Denda</vendor>
    
    <description><![CDATA[
    <h2>Yam++ Task Runner Support</h2>
    <p>Complete IDE support for Yam++ task runner and Yamfile syntax.</p>
    
    <h3>Features:</h3>
    <ul>
        <li>Syntax highlighting for Yamfile</li>
        <li>Code completion for tasks and modifiers</li>
        <li>Task execution from IDE</li>
        <li>Dependency graph visualization</li>
        <li>Quick documentation</li>
        <li>Error highlighting and validation</li>
    </ul>
    ]]></description>
    
    <depends>com.intellij.modules.platform</depends>
    
    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType name="Yamfile"
                  implementationClass="com.yampp.plugin.YamfileFileType"
                  fieldName="INSTANCE"
                  language="Yamfile"
                  extensions="Yamfile;yamfile"/>
        
        <!-- Language -->
        <lang.parserDefinition language="Yamfile"
                               implementationClass="com.yampp.plugin.YamfileParserDefinition"/>
        
        <!-- Syntax Highlighter -->
        <lang.syntaxHighlighterFactory language="Yamfile"
                                       implementationClass="com.yampp.plugin.YamfileSyntaxHighlighterFactory"/>
        
        <!-- Code Completion -->
        <completion.contributor language="Yamfile"
                               implementationClass="com.yampp.plugin.YamfileCompletionContributor"/>
        
        <!-- Run Configuration -->
        <configurationType implementation="com.yampp.plugin.YamppRunConfigurationType"/>
        <runConfigurationProducer implementation="com.yampp.plugin.YamppRunConfigurationProducer"/>
        
        <!-- Line Marker Provider -->
        <runLineMarkerContributor language="Yamfile"
                                  implementationClass="com.yampp.plugin.YamppRunLineMarkerContributor"/>
        
        <!-- Structure View -->
        <lang.psiStructureViewFactory language="Yamfile"
                                      implementationClass="com.yampp.plugin.YamfileStructureViewFactory"/>
        
        <!-- Tool Window -->
        <toolWindow id="Yam++ Tasks"
                    anchor="right"
                    factoryClass="com.yampp.plugin.YamppToolWindowFactory"
                    icon="/icons/yampp.png"/>
    </extensions>
    
    <actions>
        <!-- Run Task Action -->
        <action id="Yampp.RunTask"
                class="com.yampp.plugin.actions.RunTaskAction"
                text="Run Yam++ Task"
                description="Run selected Yam++ task">
            <add-to-group group-id="RunMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift Y"/>
        </action>
        
        <!-- List Tasks Action -->
        <action id="Yampp.ListTasks"
                class="com.yampp.plugin.actions.ListTasksAction"
                text="List Yam++ Tasks"
                description="List all available Yam++ tasks">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>
        
        <!-- Clean Cache Action -->
        <action id="Yampp.CleanCache"
                class="com.yampp.plugin.actions.CleanCacheAction"
                text="Clean Yam++ Cache"
                description="Clean all .done cache files">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="Yampp.ListTasks"/>
        </action>
    </actions>
</idea-plugin>