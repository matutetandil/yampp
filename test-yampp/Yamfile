/*
 * Yamfile de Prueba - Test de funcionalidades básicas
 * 
 * Este archivo prueba diferentes características de Yam++:
 * - Variables y constantes
 * - Dependencias entre tareas
 * - File watching
 * - Modificadores (always, serial, critical)
 * - Internal calls
 * - Salida a consola y archivos
 */

// Variables globales
const PROJECT_NAME = "yampp-test"
const VERSION = "0.4.2"
var BUILD_MODE = "development"

// Tarea simple que escribe a consola y archivo
hello {
    echo "🚀 Hola desde Yam++ v$VERSION!"
    echo "Proyecto: $PROJECT_NAME"
    echo "Modo: $BUILD_MODE"
    echo "Timestamp: $(date)" | tee output.log
    echo "Hello task completed at $(date)" >> tasks.log
}

// Tarea que simula trabajo lento
slow_task {
    echo "⏳ Iniciando tarea lenta..."
    echo "Step 1/3: Preparando..." && sleep 1
    echo "Step 2/3: Procesando..." && sleep 1  
    echo "Step 3/3: Finalizando..." && sleep 1
    echo "✅ Tarea lenta completada!"
    echo "slow_task completed" >> tasks.log
}

// Tarea que depende de otra
dependent_task needs hello {
    echo "📦 Ejecutando tarea dependiente"
    echo "Esta tarea necesita que 'hello' se haya ejecutado primero"
    cat output.log
    echo "dependent_task completed" >> tasks.log
}

// Tarea que siempre se ejecuta (bypassa cache)
always: timestamp {
    echo "🕒 Timestamp actual: $(date)"
    echo "Esta tarea siempre se ejecuta, ignora el cache"
    date > current_time.txt
}

// Tarea que vigila archivos
file_watcher watches "*.txt" "*.log" {
    echo "👀 Vigilando archivos .txt y .log"
    echo "Archivos encontrados:"
    ls -la *.txt *.log 2>/dev/null || echo "No hay archivos para vigilar aún"
    echo "file_watcher completed" >> tasks.log
}

// Tarea serial (no se ejecuta en paralelo)
serial: sequential_task {
    echo "🔄 Tarea secuencial - paso 1"
    echo "processing..." && sleep 0.5
    echo "🔄 Tarea secuencial - paso 2" 
    echo "processing..." && sleep 0.5
    echo "🔄 Tarea secuencial - paso 3"
    echo "sequential_task completed" >> tasks.log
}

// Tarea crítica (aborta todo si falla)
critical: important_task {
    echo "⚠️  Tarea crítica ejecutándose..."
    echo "Si esta tarea falla, todo se detiene"
    // Simulamos éxito por defecto
    echo "✅ Tarea crítica completada exitosamente"
    echo "important_task completed" >> tasks.log
}

// Tarea con parámetros
greet(name) {
    echo "👋 Hola, $name!"
    echo "Saludo para: $name" >> greetings.log
}

// Tarea que usa internal calls
orchestrator {
    const TIMESTAMP = "$(date +%H%M%S)"
    
    echo "🎼 Orquestador iniciado a las $TIMESTAMP"
    
    // Llamadas internas
    __call hello
    __call greet(Mundo)
    __call timestamp
    
    echo "🎼 Orquestación completada"
    echo "orchestrator completed at $TIMESTAMP" >> tasks.log
}

// Tarea de múltiples dependencias
complex_task needs hello dependent_task watches "Yamfile" {
    echo "🔧 Tarea compleja con dependencias y file watching"
    echo "Depende de: hello, dependent_task"
    echo "Vigila: Yamfile"
    echo "Creando reporte..."
    
    echo "=== REPORTE DE EJECUCIÓN ===" > report.txt
    echo "Proyecto: $PROJECT_NAME v$VERSION" >> report.txt
    echo "Fecha: $(date)" >> report.txt
    echo "Logs de tareas:" >> report.txt
    cat tasks.log >> report.txt 2>/dev/null || echo "No hay logs aún" >> report.txt
    
    echo "✅ Reporte creado en report.txt"
}

// Tarea de cleanup
always: clean {
    echo "🧹 Limpiando archivos temporales..."
    rm -f *.log *.txt
    rm -rf .yampp/
    echo "Archivos temporales eliminados"
}

// Tarea por defecto que muestra el menú
all {
    echo "🎯 Yam++ Test Suite"
    echo "=================="
    echo "Tareas disponibles:"
    echo "  hello          - Saludo básico"
    echo "  slow_task      - Simula trabajo lento"
    echo "  timestamp      - Muestra tiempo actual (always)"
    echo "  file_watcher   - Vigila archivos"
    echo "  orchestrator   - Usa internal calls"
    echo "  complex_task   - Dependencias + file watching"
    echo "  clean          - Limpia archivos"
    echo ""
    echo "Ejecuta: node ../bin/yampp.js [tarea]"
}