// Test file for input functions

serial: test_input {
    __input "Enter your name:" user_name "John"
    __input_password "Enter password:" pass
    __input_confirm "Continue?" confirm "yes"
    __input_select "Choose env:" env ["dev", "prod"] "dev"
    
    echo "Hello $user_name!"
    echo "Environment: $env"
    echo "Confirmed: $confirm"
    
    __call other_task($user_name)
}

other_task(name) {
    echo "Called with: $name"
}